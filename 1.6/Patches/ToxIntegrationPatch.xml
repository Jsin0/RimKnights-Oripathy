<?xml version="1.0" encoding="utf-8" ?>
<!--Adds oripathy chance to toxic buildup-->
<Patch>
	<Operation Class="PatchOperationSequence">
	  <operations>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="ToxicBuildup"]/comps</xpath>
				<value>
					<li Class="RimKnights.Oripathy.HediffCompProperties_DynamicSeverityRange">
						<minAffector>
							<hediff>RK_Oripathy</hediff>
							<curve>
							  <points>
								<li>(0, 0.00)</li>
								<li>(0.25, 0.05)</li>
								<li>(0.50, 0.15)</li>
								<li>(0.80, 0.25)</li>
								<li>(1.0, 0.35)</li>
							  </points>
							</curve>
						</minAffector>
						<updateInterval>60</updateInterval>
					</li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="ToxicBuildup"]/stages/li[label="moderate"]/hediffGivers</xpath>
				<value>
				  <li Class="HediffGiver_Random">
					<hediff>RK_Oripathy</hediff>
					<mtbDays>60</mtbDays>
				  </li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="ToxicBuildup"]/stages/li[label="serious"]/hediffGivers</xpath>
				<value>
				  <li Class="HediffGiver_Random">
					<hediff>RK_Oripathy</hediff>
					<mtbDays>20</mtbDays>
				  </li>
				</value>
			</li>
			<li Class="PatchOperationAdd">
				<xpath>Defs/HediffDef[defName="ToxicBuildup"]/stages/li[label="extreme"]/hediffGivers</xpath>
				<value>
				  <li Class="HediffGiver_Random">
					<hediff>RK_Oripathy</hediff>
					<mtbDays>1</mtbDays>
				  </li>
				</value>
			</li>
			<li Class="PatchOperationReplace">
				<xpath>Defs/FleckDef[defName="Fleck_ToxGasSmall"]/graphicData/color</xpath>
				<value>
					<color>(215,215,24,64)</color>
				</value>
			</li>
	  </operations>
	</Operation>
</Patch>